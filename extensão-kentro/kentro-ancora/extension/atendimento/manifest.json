{
  "manifestVersion": 1,
  "id": "kentrosistemas.ancora",
  "version": "0.1.0",
  "name": "Método ÂNCORA",
  "description": "Venda consultiva da Kentro: diagnóstico, conta ao vivo, planos, relatório de decisão e proposta para o cliente.",
  "author": { "name": "Kentro" },
  "icon": "icone.svg",
  "requires": [],
  "config": [
    {
      "key": "api_url",
      "type": "url",
      "label": "Endereço do serviço",
      "help": "Já vem preenchido. Só altere se o suporte pedir.",
      "required": true,
      "default": "__URL_PUBLICA__"
    },
    {
      "key": "chave_acesso",
      "type": "secret",
      "label": "Chave de acesso",
      "help": "O valor da variável CHAVE_EXTENSAO do serviço no Doca.",
      "required": true
    }
  ],
  "embedOrigins": ["__URL_PUBLICA__"],
  "contributions": [
    {
      "id": "abrir",
      "type": "topMenu",
      "title": "Âncora",
      "url": "abrir.html",
      "icon": "icone.svg",
      "presentation": { "mode": "dialog", "size": "sm" }
    },
    {
      "id": "painel",
      "type": "chatPanel",
      "title": "Método ÂNCORA",
      "url": "painel.html",
      "icon": "icone.svg"
    }
  ]
}
