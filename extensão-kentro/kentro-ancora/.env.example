# Variáveis do serviço (no Doca, cadastre em Variáveis do projeto; localmente, copie para .env).
# Nunca coloque valores reais neste arquivo.

# Banco Postgres do Doca (o projeto precisa estar LIGADO ao banco). As tabelas são criadas na subida.
DATABASE_URL=postgres://usuario:senha@apps-postgres:5432/kentro_ancora

# Endereço público HTTPS do serviço, sem barra final (o mesmo domínio que vai no manifest da extensão).
URL_PUBLICA=https://kentro-ancora.kentro.com.br

# Assina as sessões; trocar derruba quem está conectado.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SEGREDO_SESSAO=
